rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasRole(userId, role) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == role;
    }

    function validArtistRate(data) {
      return data.type is string
        && data.type.size() > 0
        && data.type.size() <= 60
        && data.description is string
        && data.description.size() <= 400
        && data.price is number
        && data.price > 0
        && data.price <= 10000000;
    }

    function commission(commissionId) {
      return get(/databases/$(database)/documents/commissions/$(commissionId)).data;
    }

    function isCommissionParticipant(commissionId) {
      let item = commission(commissionId);
      return signedIn()
        && (request.auth.uid == item.artistId || request.auth.uid == item.clientId);
    }

    function approvedStagesUnchanged() {
      let oldData = resource.data.stageData;
      let newData = request.resource.data.stageData;
      let approved = resource.data.clientApproval;
      return (!approved[0] || newData[0] == oldData[0])
        && (!approved[1] || newData[1] == oldData[1])
        && (!approved[2] || newData[2] == oldData[2])
        && (!approved[3] || newData[3] == oldData[3])
        && (!approved[4] || newData[4] == oldData[4]);
    }

    function clientReviewValid() {
      let oldApproval = resource.data.clientApproval;
      let newApproval = request.resource.data.clientApproval;
      let ready = resource.data.stageStatus;
      let oldReady = resource.data.stageStatus;
      let newReady = request.resource.data.stageStatus;
      return (!oldApproval[0] || newApproval[0])
        && (!newApproval[0] || oldApproval[0] || ready[0])
        && (!oldApproval[1] || newApproval[1])
        && (!newApproval[1] || oldApproval[1] || ready[1])
        && (!oldApproval[2] || newApproval[2])
        && (!newApproval[2] || oldApproval[2] || ready[2])
        && (!oldApproval[3] || newApproval[3])
        && (!newApproval[3] || oldApproval[3] || ready[3])
        && (!oldApproval[4] || newApproval[4])
        && (!newApproval[4] || oldApproval[4] || ready[4])
        && (!newReady[0] || oldReady[0])
        && (!newReady[1] || oldReady[1])
        && (!newReady[2] || oldReady[2])
        && (!newReady[3] || oldReady[3])
        && (!newReady[4] || oldReady[4])
        && request.resource.data.currentStage >= resource.data.currentStage
        && request.resource.data.currentStage <= 4
        && (request.resource.data.currentStage == resource.data.currentStage
          || request.resource.data.currentStage == resource.data.currentStage + 1
            && newApproval[resource.data.currentStage])
        && (request.resource.data.status == resource.data.status
          || request.resource.data.status == 'done'
            && newApproval[0] && newApproval[1] && newApproval[2] && newApproval[3] && newApproval[4]);
    }

    match /users/{userId} {
      allow read: if resource.data.role == 'artist' || isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'name', 'role', 'specialty', 'description', 'socialLink', 'profileViews', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'role', 'specialty', 'description', 'socialLink', 'profileViews', 'createdAt'
        ])
        && request.resource.data.role in ['artist', 'customer']
        && request.resource.data.profileViews == 0;

      allow update: if (isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'specialty', 'description', 'socialLink', 'updatedAt'
        ]))
        || (resource.data.role == 'artist'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileViews'])
          && request.resource.data.profileViews == resource.data.profileViews + 1);

      allow delete: if false;

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if signedIn()
          && request.resource.data.userId == userId
          && request.resource.data.commissionId is string
          && isCommissionParticipant(request.resource.data.commissionId)
          && userId in [
            commission(request.resource.data.commissionId).artistId,
            commission(request.resource.data.commissionId).clientId
          ]
          && request.resource.data.keys().hasOnly([
            'userId', 'type', 'commissionId', 'text', 'isRead', 'createdAt'
          ])
          && request.resource.data.isRead == false;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if false;
      }
    }

    match /artworks/{artworkId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.artistId
        && hasRole(request.auth.uid, 'artist')
        && request.resource.data.keys().hasAll([
          'artistId', 'artist', 'title', 'detail', 'price', 'category', 'image', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'artistId', 'artist', 'title', 'detail', 'price', 'category', 'image', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 700000
        && request.resource.data.price is number
        && request.resource.data.price > 0;
      allow update: if signedIn()
        && request.auth.uid == resource.data.artistId
        && request.resource.data.artistId == resource.data.artistId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'artist', 'title', 'detail', 'price', 'category', 'image'
        ]);
      allow delete: if signedIn() && request.auth.uid == resource.data.artistId;
    }

    match /artistRates/{rateId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.artistId
        && hasRole(request.auth.uid, 'artist')
        && request.resource.data.keys().hasAll(['artistId', 'type', 'description', 'price', 'createdAt'])
        && request.resource.data.keys().hasOnly(['artistId', 'type', 'description', 'price', 'createdAt'])
        && validArtistRate(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == resource.data.artistId
        && hasRole(request.auth.uid, 'artist')
        && request.resource.data.artistId == resource.data.artistId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'description', 'price'])
        && validArtistRate(request.resource.data);
      allow delete: if signedIn()
        && request.auth.uid == resource.data.artistId
        && hasRole(request.auth.uid, 'artist');
    }

    match /commissions/{commissionId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.artistId || request.auth.uid == resource.data.clientId);

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.clientId
        && hasRole(request.auth.uid, 'customer')
        && hasRole(request.resource.data.artistId, 'artist')
        && request.resource.data.artistId != request.resource.data.clientId
        && request.resource.data.status == 'pending'
        && request.resource.data.currentStage == 0
        && request.resource.data.keys().hasAll([
          'artistId', 'clientId', 'artistName', 'clientName', 'title', 'description',
          'referenceImage', 'status', 'currentStage', 'stageStatus', 'clientApproval',
          'stageData', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'artistId', 'clientId', 'artistName', 'clientName', 'title', 'description',
          'referenceImage', 'status', 'currentStage', 'stageStatus', 'clientApproval',
          'stageData', 'createdAt', 'updatedAt'
        ]);

      allow update: if (signedIn()
        && request.auth.uid == resource.data.artistId
        && resource.data.status == 'pending'
        && request.resource.data.status in ['active', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || (signedIn()
          && request.auth.uid == resource.data.artistId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stageData', 'stageStatus', 'updatedAt'])
          && request.resource.data.clientApproval == resource.data.clientApproval
          && approvedStagesUnchanged())
        || (signedIn()
          && request.auth.uid == resource.data.clientId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'clientApproval', 'currentStage', 'status', 'stageStatus', 'updatedAt'
          ])
          && clientReviewValid());

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isCommissionParticipant(commissionId);
        allow create: if isCommissionParticipant(commissionId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          && request.resource.data.isRead == false
          && request.resource.data.keys().hasAll([
            'senderId', 'senderName', 'senderRole', 'message', 'isRead', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'senderRole', 'message', 'isRead', 'createdAt'
          ])
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0;
        allow update: if isCommissionParticipant(commissionId)
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead == true;
        allow delete: if false;
      }
    }
  }
}